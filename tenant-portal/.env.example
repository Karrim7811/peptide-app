# Supabase — use a DEDICATED Supabase project for the tenant portal,
# NOT the Peptide Cortex project. Run supabase/schema.sql against it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — a dedicated Stripe account (or at minimum separate keys) is strongly
# recommended so rent income is not mixed with Peptide Cortex subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of emails allowed into /admin (the landlord).
ADMIN_EMAILS=karimnp@gmail.com

# Public base URL of the deployed portal (used for Stripe redirect URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Display name shown in the header / browser tab.
NEXT_PUBLIC_PORTAL_NAME="Tenant Portal"
