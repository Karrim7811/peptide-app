# =============================================================
# Peptide Cortex — environment variables
# Copy to .env.local for development. Set on Vercel for production.
# Every variable is required unless explicitly noted.
# =============================================================

# Supabase (used by client + server + API routes)
#   NEXT_PUBLIC_* values are exposed to the browser; the anon key is fine
#   on the client because all access is RLS-gated.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
#   SERVER-ONLY. Bypasses RLS. Required for the Stripe webhook to write Pro
#   status to profiles (the webhook has no user session, so anon is RLS-denied).
#   Never prefix with NEXT_PUBLIC_ and never expose to the browser.
#   Get it from Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude (used by all /api/* AI endpoints — server-only)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Stripe — payments (use live keys in production only)
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is exposed to the browser.
#   STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only.
#   The price IDs come from Stripe Dashboard -> Products.
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Prices — see CLAUDE.md S16.4 / S16.5 for the locked pricing
#   STRIPE_PRO_MONTHLY_PRICE_ID  -> recurring $14.99/mo Pro subscription
#   STRIPE_PRO_ANNUAL_PRICE_ID   -> recurring $119.88/yr Pro subscription
#   STRIPE_PRO_LIFETIME_PRICE_ID -> one-time $99.99 Lifetime Pro purchase
#
# Pricing changed 2026-08-06 with the Mirror redesign: monthly moved $9.99 ->
# $14.99 and annual ($119.88/yr, shown as $9.99/mo) was introduced. Both need
# NEW live Stripe prices — the existing monthly price ID is still $9.99.
# Lifetime is no longer sold on the pricing page; the price stays configured so
# existing links and the founder path keep working.
#
# Subscriptions carry a trial (TRIAL_DAYS in src/lib/pricing.ts, currently 30),
# which is what makes the page's "No card charged for a month" promise true.
#   (The deprecated yearly SKU has been removed.)
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
STRIPE_PRO_LIFETIME_PRICE_ID=price_...
#
# Test-mode prices exist as of 2026-08-07 on product prod_U9BwnRqqwMy88z:
#   monthly $14.99  price_1U1uH2HCjY7acAQmN2FT6PtA
#   annual  $119.88 price_1U1uH2HCjY7acAQmUpHj5llJ
# LIVE MODE STILL NEEDS BOTH CREATING. The live monthly price is still $9.99
# while the pricing page says $14.99 — do not edit that price, Stripe prices
# are immutable and existing subscribers stay on it. Create new ones.
